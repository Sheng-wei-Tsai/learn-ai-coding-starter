{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4.1-flash-free",
  "providers": {
    "opencode": {
      "models": {
        "deepseek-v4.1-flash-free": {
          "body": {
            "reasoning_effort": "none",
            "temperature": 0.1
          }
        }
      }
    }
  },
  "watcher": {
    "ignore": ["logs/**"]
  },
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 10000
    },
    "buffer": 20000
  },
  "permissions": [
    {
      "action": "shell",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "bootdev run *",
      "effect": "allow"
    },
    {
      "action": "run_slop",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "subagent",
      "resource": "explore",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env",
      "effect": "deny"
    }
  ]
}
